<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_project_budget" model="ir.ui.view">
        <field name="name">account.move.form.project.budget</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@id='header_left_group']" position="inside">
                <field name="is_budget_journal" invisible="1"/>
                <field name="project_id"
                    invisible="not is_budget_journal"
                    readonly="state != 'draft'"
                    required="is_budget_journal"
                    options="{'no_create': True}"/>
            </xpath>
            <xpath expr="//page[@name='aml_tab']//list//field[@name='analytic_distribution']" position="before">
                <field name="product_id"
                    optional="show"
                    column_invisible="not parent.is_budget_journal"
                    options="{'no_create': True}"/>
                <field name="budget_line_id"
                    optional="show"
                    column_invisible="not parent.is_budget_journal"
                    domain="[
                        ('budget_analytic_id.state', 'in', ['confirmed', 'done']),
                        '|', ('company_id', '=', False), ('company_id', '=', parent.company_id),
                        '|', ('product_id', '=', False), ('product_id', '=', product_id),
                        ('budget_project_id', '=', parent.project_id),
                    ]"
                    options="{'no_create': True}"/>
            </xpath>
            <xpath expr="//page[@name='aml_tab']//form//field[@name='analytic_distribution']"
                position="before">
                <field name="product_id"
                    invisible="not parent.is_budget_journal"
                    options="{'no_create': True}"/>
                <field name="budget_line_id"
                    invisible="not parent.is_budget_journal"
                    domain="[
                        ('budget_analytic_id.state', 'in', ['confirmed', 'done']),
                        '|', ('company_id', '=', False), ('company_id', '=', parent.company_id),
                        '|', ('product_id', '=', False), ('product_id', '=', product_id),
                        ('budget_project_id', '=', parent.project_id),
                    ]"
                    options="{'no_create': True}"/>
            </xpath>
        </field>
    </record>

    <record id="view_move_tree_project_budget" model="ir.ui.view">
        <field name="name">account.move.list.project.budget</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_tree"/>
        <field name="arch" type="xml">
            <field name="journal_id" position="after">
                <field name="is_budget_journal" column_invisible="1"/>
                <field name="project_id" optional="show"/>
            </field>
        </field>
    </record>

    <record id="action_budget_journal_entry" model="ir.actions.act_window">
        <field name="name">Budget Journal Entries</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form,activity</field>
        <field name="view_id" ref="account.view_move_tree"/>
        <field name="search_view_id" ref="account.view_account_move_filter"/>
        <field name="domain">[('move_type', '=', 'entry'), ('is_budget_journal', '=', True)]</field>
        <field name="context">{
            'default_move_type': 'entry',
            'default_is_budget_journal': True,
            'view_no_maturity': True,
            'search_default_posted': 1,
        }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a budget journal entry
            </p>
            <p>
                Record expenses or adjustments against a budget line.
                Select <strong>Project</strong> first to filter budget lines, then pick
                <strong>Product</strong> to auto-fill the budget line, or choose
                <strong>Budget Line</strong> directly. Posting updates budget achieved.
            </p>
        </field>
    </record>

    <menuitem id="menu_budget_journal_entry"
        name="Budget Journal Entries"
        parent="account.account_transactions_menu"
        action="action_budget_journal_entry"
        groups="account.group_account_user"
        sequence="2"/>
</odoo>
