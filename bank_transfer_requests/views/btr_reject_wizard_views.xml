<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_btr_reject_wizard_form" model="ir.ui.view">
    <field name="name">btr.reject.wizard.form</field>
    <field name="model">btr.reject.wizard</field>
    <field name="arch" type="xml">
      <form string="Reject Bank Transfer">
        <group>
          <field name="request_id" invisible="1"/>
          <field name="reason" required="1"/>
        </group>
        <footer>
          <button name="action_confirm_reject" string="Reject" type="object" class="btn-primary"/>
          <button string="Cancel" special="cancel"/>
        </footer>
      </form>
    </field>
  </record>
</odoo>
