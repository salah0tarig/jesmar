<odoo>
  <record id="view_btr_request_list" model="ir.ui.view">
    <field name="name">fund.transfer.request.list</field><field name="model">fund.transfer.request</field>
    <field name="arch" type="xml"><list>
      <field name="name"/><field name="source_company_id"/><field name="destination_company_id"/>
      <field name="amount"/><field name="currency_id" column_invisible="True"/><field name="state"/>
    </list></field>
  </record>
  <record id="view_btr_request_form" model="ir.ui.view">
    <field name="name">fund.transfer.request.form</field><field name="model">fund.transfer.request</field>
    <field name="arch" type="xml">
      <form string="Bank Transfer Request">
        <header>
          <button name="action_submit" type="object" string="Submit" class="btn-primary" invisible="state != 'draft'" groups="bank_transfer_requests.group_branch_user"/>
          <button name="action_approve" type="object" string="Approve" class="btn-primary" invisible="state != 'pending'" groups="bank_transfer_requests.group_branch_finance,bank_transfer_requests.group_hq_finance"/>
          <button name="action_reject" type="object" string="Reject" invisible="state != 'pending'" groups="bank_transfer_requests.group_branch_finance,bank_transfer_requests.group_hq_finance"/>
          <button name="action_verify_send" type="object" string="Verify &amp; Send" class="btn-primary" invisible="state != 'approved'" groups="bank_transfer_requests.group_branch_finance,bank_transfer_requests.group_hq_finance"/>
          <button name="action_confirm_receipt" type="object" string="Confirm Receipt" class="btn-primary" invisible="state != 'awaiting_receipt'" groups="bank_transfer_requests.group_branch_finance"/>
          <field name="state" widget="statusbar" statusbar_visible="draft,pending,approved,awaiting_receipt,completed"/>
        </header>
        <sheet>
          <group><group>
            <field name="name" readonly="1"/>
            <field name="company_id" readonly="1"/>
            <field name="source_company_id" readonly="state != 'draft'"/>
            <field name="source_bank_journal_id" readonly="state != 'draft'"/>
          </group><group>
            <field name="destination_company_id" readonly="1"/>
            <field name="destination_bank_journal_id" readonly="state != 'draft'"/>
            <field name="amount" readonly="state != 'draft'"/>
            <field name="currency_id" invisible="1"/>
          </group></group>
          <group><field name="memo" readonly="state != 'draft'"/></group>
          <group string="Approval and Transfer Audit"><group>
            <field name="approved_by_id"/><field name="approved_date"/>
            <field name="sent_by_id"/><field name="sent_date"/>
            <field name="bank_reference"/>
          </group><group>
            <field name="received_by_id"/><field name="received_date"/>
            <field name="receipt_reference"/><field name="reject_reason"/>
          </group></group>
          <group string="Accounting Entries"><group>
            <field name="sending_move_id" readonly="1"/>
            <field name="receiving_move_id" readonly="1"/>
          </group></group>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>
  <record id="action_btr_requests" model="ir.actions.act_window">
    <field name="name">Bank Transfer Requests</field>
    <field name="res_model">fund.transfer.request</field>
    <field name="view_mode">list,form</field>
  </record>
  <menuitem id="menu_btr_root" name="Bank Transfers" sequence="65" groups="bank_transfer_requests.group_branch_user,bank_transfer_requests.group_branch_finance,bank_transfer_requests.group_hq_finance"/>
  <menuitem id="menu_btr_requests" name="Transfer Requests" parent="menu_btr_root" action="action_btr_requests" sequence="10"/>
</odoo>
