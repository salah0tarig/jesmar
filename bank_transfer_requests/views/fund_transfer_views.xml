<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- List View -->
    <record id="view_fund_transfer_list" model="ir.ui.view">
        <field name="name">fund.transfer.request.list</field>
        <field name="model">fund.transfer.request</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="company_id"  readonly="1"/>
                <field name="source_company_id"/>
                <field name="destination_company_id"  readonly="1"/>
                <field name="amount" />
                <field name="state"/>
                <field name="destination_bank_journal_id"
                    domain="[('type','=','bank'),('company_id','=',destination_company_id)]"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_fund_transfer_form" model="ir.ui.view">
        <field name="name">fund.transfer.request.form</field>
        <field name="model">fund.transfer.request</field>
        <field name="arch" type="xml">
            <form string="Bank Transfer Request">
                    <header>

                        <button
                            name="action_submit"
                            string="Submit"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'draft'"
                            groups="bank_transfer_requests.group_branch_user"/>

                        <button
                            name="action_approve"
                            string="Approve"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'pending'"
                            groups="bank_transfer_requests.group_branch_finance,bank_transfer_requests.group_hq_finance"/>

                        <button
                            name="action_reject"
                            string="Reject"
                            type="object"
                            invisible="state != 'pending'"
                            groups="bank_transfer_requests.group_branch_finance,bank_transfer_requests.group_hq_finance"/>

                        <button name="action_verify_send" string="Verify &amp; Send" type="object" class="btn-primary" invisible="state != 'approved'" groups="bank_transfer_requests.group_branch_finance,bank_transfer_requests.group_hq_finance"/>
                        <button name="action_confirm_receipt" string="Confirm Receipt" type="object" class="btn-primary" invisible="state != 'awaiting_receipt'" groups="bank_transfer_requests.group_branch_finance,bank_transfer_requests.group_hq_finance"/>
                        <field name="state"
                            widget="statusbar"
                            statusbar_visible="draft,pending,approved,awaiting_receipt,completed"/>

                    </header>

                <sheet>
                    <group>
                        <field name="name" readonly="1"/>
                        <field name="company_id" invisible="1"/>
                    </group>

                    <group string="Transfer Details">
                        <group>
                            <field name="source_company_id" readonly="state != 'draft'"/>
                            <field name="source_bank_journal_id" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="destination_company_id" readonly="state != 'draft'"/>
                            <field name="destination_bank_journal_id" readonly="state != 'draft'"/>
                        </group>
                    </group>

                    <group string="Decision" invisible="state not in ('approved', 'rejected')">
                        <field name="reject_reason" invisible="state != 'rejected'" readonly="1"/>
                    </group>

                    <group string="Sending Accounting" invisible="not sending_move_id">
                        <field name="sending_move_id" readonly="1"/>
                    </group>
                    <group string="Transfer Tracking" invisible="state not in ('awaiting_receipt', 'completed')">
                        <group><field name="bank_reference" readonly="1"/><field name="sent_by_id" readonly="1"/><field name="sent_date" readonly="1"/></group>
                        <group><field name="receipt_reference" readonly="1"/><field name="received_by_id" readonly="1"/><field name="received_date" readonly="1"/></group>
                    </group>
                    <group string="Amount and Purpose">
                        <field name="currency_id" invisible="1"/>
                        <field name="amount" readonly="state != 'draft'"/>
                        <field name="memo" readonly="state != 'draft'"/>
                    </group>
                </sheet>

                <chatter/>
            </form>
        </field>
    </record>

    <!-- Window Action -->
    <record id="action_fund_transfer" model="ir.actions.act_window">
        <field name="name">Bank Transfer Requests</field>
        <field name="res_model">fund.transfer.request</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Accounting Menu -->
    <!-- Bank Transfers under Accounting -->
    <menuitem
        id="menu_fund_transfer_root"
        name="Bank Transfers"
        parent="accountant.menu_accounting"
        groups="bank_transfer_requests.group_branch_user,bank_transfer_requests.group_branch_finance,bank_transfer_requests.group_hq_finance"
        sequence="30"/>

    <menuitem
        id="menu_fund_transfer"
        name="Transfer Requests"
        parent="menu_fund_transfer_root"
        action="action_fund_transfer"
        groups="bank_transfer_requests.group_branch_user,bank_transfer_requests.group_branch_finance,bank_transfer_requests.group_hq_finance"
        sequence="10"/>

</odoo>
