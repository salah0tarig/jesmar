<odoo>
  <record id="group_branch_user" model="res.groups"><field name="name">Branch User</field></record>
  <record id="group_branch_finance" model="res.groups"><field name="name">Branch Finance</field></record>
  <record id="group_hq_finance" model="res.groups"><field name="name">HQ Finance</field></record>
  <record id="rule_btr_visible_to_participants" model="ir.rule">
    <field name="name">Bank Transfers: Participating Branches</field>
    <field name="model_id" ref="model_fund_transfer_request"/>
    <field name="domain_force">['|', ('source_company_id', 'in', user.company_ids.ids), ('destination_company_id', 'in', user.company_ids.ids)]</field>
    <field name="groups" eval="[(4, ref('group_branch_user')), (4, ref('group_branch_finance')), (4, ref('group_hq_finance'))]"/>
  </record>
</odoo>
