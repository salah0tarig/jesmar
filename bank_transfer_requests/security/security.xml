<odoo>

    <record id="module_category_bank_transfer" model="ir.module.category">
        <field name="name">Bank Transfer</field>
        <field name="sequence">20</field>
    </record>

    <record id="privilege_bank_transfer" model="res.groups.privilege">
        <field name="name">Bank Transfer</field>
        <field name="category_id" ref="module_category_bank_transfer"/>
        <field name="sequence">10</field>
    </record>

    <record id="group_branch_user" model="res.groups">
        <field name="name">Branch User</field>
        <field name="privilege_id" ref="privilege_bank_transfer"/>
    </record>

    <record id="group_branch_finance" model="res.groups">
        <field name="name">Branch Finance</field>
        <field name="privilege_id" ref="privilege_bank_transfer"/>
    </record>

    <record id="group_hq_finance" model="res.groups">
        <field name="name">HQ Finance</field>
        <field name="privilege_id" ref="privilege_bank_transfer"/>
    </record>

</odoo>