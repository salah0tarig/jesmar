<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_payment_register_payroll_journal" model="ir.ui.view">
        <field name="name">account.payment.register.form.payroll.journal</field>
        <field name="model">account.payment.register</field>
        <field name="inherit_id" ref="account.view_account_payment_register_form"/>
        <field name="priority">200</field>
        <field name="arch" type="xml">
            <field name="journal_id" position="before">
                <field name="payroll_journal_ids" invisible="1"/>
            </field>
            <field name="journal_id" position="attributes">
                <attribute name="domain">[('id', 'in', payroll_journal_ids)]</attribute>
            </field>
        </field>
    </record>
</odoo>
