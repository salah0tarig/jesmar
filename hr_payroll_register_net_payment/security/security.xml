<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- The standard company rule blocks read when the user's active company
         is not the line's company. Keep that restriction for write/create/unlink.
         Read is granted to internal users below. -->
    <record id="account.account_move_line_comp_rule" model="ir.rule">
        <field name="perm_read" eval="False"/>
    </record>

    <record id="account_move_line_internal_user_read" model="ir.rule">
        <field name="name">Journal items: internal users can read</field>
        <field name="model_id" ref="account.model_account_move_line"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
</odoo>
