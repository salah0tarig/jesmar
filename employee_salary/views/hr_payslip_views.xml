<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_payslip_form_inherit_subsistence" model="ir.ui.view">
        <field name="name">hr.payslip.form.inherit.subsistence</field>
        <field name="model">hr.payslip</field>
        <field name="inherit_id" ref="hr_payroll.view_hr_payslip_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='top_left']" position="inside">
                <field name="subsistence_allowance_type" invisible="1"/>
            </xpath>

            <xpath expr="//group[@name='top']" position="inside">
                <group string="Subsistence Allowance"
                       name="subsistence_allowance_group"
                       invisible="subsistence_allowance_type not in ('fixed', 'daily')">
                    <field name="currency_id" invisible="1"/>

                    <field name="fixed_subsistence_amount"
                           string="Fixed Monthly Amount"
                           readonly="1"
                           invisible="subsistence_allowance_type != 'fixed'"/>

                    <field name="project_id"
                           string="Project (optional)"
                           readonly="state in ['cancel', 'validated', 'paid']"
                           invisible="subsistence_allowance_type != 'daily'"
                           placeholder="All projects"/>

                    <label for="field_work_days"
                           string="Field Work Days"
                           invisible="subsistence_allowance_type != 'daily'"/>
                    <div invisible="subsistence_allowance_type != 'daily'">
                        <field name="field_work_days" class="oe_inline" readonly="1"/>
                        <span class="text-muted ms-1">from project task timesheet lines</span>
                    </div>

                    <field name="daily_subsistence_rate"
                           string="Daily Rate"
                           readonly="1"
                           invisible="subsistence_allowance_type != 'daily'"/>

                    <field name="daily_subsistence_amount"
                           string="Subsistence Total"
                           readonly="1"
                           class="fw-bold"
                           invisible="subsistence_allowance_type != 'daily'"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
