<odoo>
    <delete model="ir.ui.view" id="hr_employee_form_inherit_daily_subsistence_rate"/>

    <record id="hr_employee_form_inherit_salary" model="ir.ui.view">
        <field name="name">hr.employee.form.inherit.salary</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="priority" eval="50"/>
        <field name="arch" type="xml">
            <xpath expr="//label[@for='wage']" position="before">
                <field name="approval_amount"/>
                <field name="social_insurance"/>
            </xpath>
            <xpath expr="//div[@name='wage']/field[@name='wage']" position="attributes">
                <attribute name="readonly">1</attribute>
            </xpath>
            <xpath expr="//group[@name='payroll_group']" position="inside">
                <field name="subsistence_allowance_type" readonly="1"/>
                <field name="fixed_subsistence_amount" readonly="1"
                       invisible="subsistence_allowance_type != 'fixed'"/>
                <field name="subsistence_allowance_source" readonly="1"
                       invisible="subsistence_allowance_type == 'none'"/>
            </xpath>
            <xpath expr="//group[@name='application_group']" position="after">
                <group string="Daily Subsistence"
                       invisible="subsistence_allowance_type == 'fixed'">
                    <field name="subsistence_allowance_type" invisible="1"/>
                    <field name="daily_subsistence_rate"/>
                    <field name="currency_id" invisible="1"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
