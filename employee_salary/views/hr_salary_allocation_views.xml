<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_employee_form_salary_budget_allocation" model="ir.ui.view">
        <field name="name">hr.employee.form.salary.budget.allocation</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/notebook" position="inside">
                <page string="Salary budget allocation" name="salary_budget_allocation"
                      groups="hr.group_hr_manager">
                    <p class="text-muted">
                        Optional. If empty (and no lines on the payslip), the journal entry
                        stays standard Odoo. When set, expense debits are split by % for
                        budget analytic/product only — debit/credit totals unchanged.
                    </p>
                    <field name="version_id" invisible="1"/>
                    <field name="salary_allocation_ids"
                           context="{'default_version_id': version_id}"
                           readonly="not version_id">
                        <list editable="bottom">
                            <field name="company_id" column_invisible="1"/>
                            <field name="budget_line_id"
                                   options="{'no_create': True}"
                                   domain="[('budget_analytic_id.state', '=', 'confirmed'), ('budget_analytic_id.company_id', '=', company_id)]"/>
                            <field name="budget_project_id" optional="show"/>
                            <field name="product_id" optional="show"/>
                            <field name="analytic_account_id" optional="show"/>
                            <field name="percentage" sum="Total %"/>
                            <field name="total_employee_cost" column_invisible="1"/>
                            <field name="currency_id" column_invisible="1"/>
                            <field name="allocated_amount" sum="Total Amount"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_hr_payslip_form_salary_budget_allocation" model="ir.ui.view">
        <field name="name">hr.payslip.form.salary.budget.allocation</field>
        <field name="model">hr.payslip</field>
        <field name="inherit_id" ref="hr_payroll.view_hr_payslip_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/notebook" position="inside">
                <page string="Budget allocation" name="salary_budget_allocation"
                      invisible="state == 'cancel'">
                    <button name="action_copy_salary_allocations_from_contract"
                            type="object"
                            string="Copy from employee record"
                            class="btn-secondary mb-2"
                            invisible="state != 'draft'"/>
                    <p class="text-muted">
                        Leave empty to keep a normal Odoo journal entry (uses employee
                        allocations only if set there). When set, expense debits are split by %
                        without changing debit/credit totals.
                    </p>
                    <field name="salary_allocation_ids"
                           readonly="state != 'draft'"
                           context="{'default_payslip_id': id}">
                        <list editable="bottom">
                            <field name="company_id" column_invisible="1"/>
                            <field name="budget_line_id"
                                   options="{'no_create': True}"
                                   domain="[('budget_analytic_id.state', '=', 'confirmed'), ('budget_analytic_id.company_id', '=', company_id)]"/>
                            <field name="budget_project_id" optional="show"/>
                            <field name="product_id" optional="show"/>
                            <field name="analytic_account_id" optional="show"/>
                            <field name="percentage" sum="Total %"/>
                            <field name="total_employee_cost" column_invisible="1"/>
                            <field name="currency_id" column_invisible="1"/>
                            <field name="allocated_amount" sum="Total Amount"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
