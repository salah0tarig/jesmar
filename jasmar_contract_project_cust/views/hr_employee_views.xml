<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_form_contract" model="ir.ui.view">
        <field name="name">hr.employee.form.contract</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='hr_document_group']" position="inside">
                <field name="contract_document" filename="contract_filename"/>
                <field name="contract_filename" invisible="1"/>
            </xpath>
        </field>
    </record>
</odoo>
