<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_project_project_form_voucher_donor" model="ir.ui.view">
        <field name="name">project.project.form.voucher.donor</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="donor_id" widget="res_partner_many2one"/>
            </xpath>
        </field>
    </record>
</odoo>
