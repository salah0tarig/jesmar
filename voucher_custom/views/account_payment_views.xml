<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_payment_form_voucher_custom" model="ir.ui.view">
        <field name="name">account.payment.form.voucher.custom</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">

            <xpath expr="//div[@name='amount_div']" position="after">
                <field name="amount_in_words" readonly="1"/>
            </xpath>
            <xpath expr="//notebook[@name='payment_notebook']" position="inside">
                <page string="Payment Voucher" name="payment_voucher">
                    <group>
                        <group>
                            <field name="voucher_project_display" invisible="1" readonly="1"/>
                            <field name="voucher_project_aa_display" readonly="1" invisible="1"/>
                            <field name="voucher_donor_display" readonly="1" invisible="1"/>
                            <field name="voucher_check_number" readonly="1" invisible="1"/>
                        </group>
                    </group>
                    <group string="Signatures">
                        <field name="voucher_signature_ids" nolabel="1">
                            <list editable="bottom">
                                <field name="sequence" widget="handle"/>
                                <field name="role"/>
                                <field name="employee_id" domain="['|', ('company_id', '=', False), ('company_id', '=', parent.company_id)]"/>
                                <field name="signer_position" readonly="1"/>
                                <field name="signature" widget="image" options="{'size': [120, 40]}"/>
                            </list>
                        </field>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
