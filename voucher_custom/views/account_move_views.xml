<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_voucher_custom" model="ir.ui.view">
        <field name="name">account.move.form.voucher.custom</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='ref'][@invisible=&quot;move_type != 'entry'&quot;]" position="after">
                <field name="voucher_entered_on" invisible="move_type != 'entry'"/>
                <field name="voucher_quick_notes" invisible="move_type != 'entry'"/>
            </xpath>
        </field>
    </record>
</odoo>
