<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_payment_voucher_document">
        <t t-call="web.external_layout">
            <t t-set="o" t-value="o.with_context(lang=lang)"/>
            <t t-set="layout_document_title" t-value="''"/>
            <t t-set="values" t-value="o._get_payment_voucher_report_values(voucher_type=voucher_type)"/>
            <div class="page o_voucher_custom">
                <style>
                    /* Tighter spacing inside standard external layout */
                    .o_report_layout_standard .header {
                        margin-bottom: 2px !important;
                    }
                    .o_report_layout_standard .article {
                        padding-top: 0 !important;
                    }
                    .o_voucher_custom {
                        font-size: 10pt;
                        line-height: 1.25;
                        color: #333;
                        margin: 0;
                        padding-top: 4px;
                    }
                    .o_voucher_custom .o_vc-main-title {
                        font-size: 14pt;
                        font-weight: 700;
                        letter-spacing: 1px;
                        color: #111;
                        padding: 0 0 4px;
                        margin: 0 0 8px;
                        text-align: center;
                        border-bottom: 2px solid #333;
                    }
                    .o_voucher_custom table {
                        width: 100%;
                        border-collapse: collapse;
                        table-layout: fixed;
                    }
                    .o_voucher_custom .o_vc-meta,
                    .o_voucher_custom .o_vc-details,
                    .o_voucher_custom .o_vc-table,
                    .o_voucher_custom .o_vc-signatures {
                        border: 1px solid #bbb;
                        margin-bottom: 3px;
                    }
                    .o_voucher_custom .o_vc-meta {
                        margin-top: 2px;
                    }
                    .o_voucher_custom .o_vc-meta td,
                    .o_voucher_custom .o_vc-details td,
                    .o_voucher_custom .o_vc-table td,
                    .o_voucher_custom .o_vc-signatures td {
                        border: 1px solid #ddd;
                        padding: 3px 8px;
                        vertical-align: top;
                    }
                    .o_voucher_custom .o_vc-label {
                        width: 18%;
                        font-weight: 600;
                        color: #444;
                        background-color: #f5f5f5;
                        white-space: nowrap;
                    }
                    .o_voucher_custom .o_vc-value {
                        word-wrap: break-word;
                        overflow-wrap: break-word;
                    }
                    .o_voucher_custom .o_vc-value-long {
                        font-size: 9.5pt;
                        line-height: 1.2;
                    }
                    .o_voucher_custom .o_vc-digital {
                        width: 28%;
                        background-color: #fafafa;
                        font-size: 9.5pt;
                        vertical-align: top;
                        padding: 4px 8px 8px;
                    }
                    .o_voucher_custom .o_vc-digital-sub {
                        margin-top: 4px;
                        padding-bottom: 4px;
                        line-height: 1.3;
                    }
                    .o_voucher_custom .o_vc-details .o_vc-label {
                        white-space: normal;
                        width: 22%;
                    }
                    .o_voucher_custom .o_vc-details .o_vc-value-long {
                        font-size: 9.5pt;
                        line-height: 1.2;
                    }
                    .o_voucher_custom .o_vc-note-row td {
                        font-style: italic;
                        color: #555;
                        background-color: #fafafa;
                        padding: 3px 8px;
                        font-size: 9.5pt;
                    }
                    .o_voucher_custom .o_vc-table .o_vc-table-head td {
                        background-color: #f0f0f0;
                        font-weight: 600;
                        font-size: 9.5pt;
                        padding: 3px 8px;
                    }
                    .o_voucher_custom .o_vc-table .o_vc-table-total td {
                        font-weight: 700;
                        background-color: #f9f9f9;
                        border-top: 1px solid #999;
                    }
                    .o_voucher_custom .o_vc-table .o_vc-amount {
                        width: 13%;
                        white-space: nowrap;
                        padding: 3px 6px;
                    }
                    .o_voucher_custom .o_vc-table .o_vc-col-gl {
                        width: 22%;
                    }
                    .o_voucher_custom .o_vc-table .o_vc-col-dept {
                        width: 10%;
                    }
                    .o_voucher_custom .o_vc-table .o_vc-col-desc {
                        width: 42%;
                    }
                    .o_voucher_custom .o_vc-section-title td {
                        background-color: #eee;
                        font-weight: 600;
                        font-size: 9.5pt;
                        padding: 2px 8px;
                    }
                    .o_voucher_custom .o_vc-signatures {
                        page-break-inside: avoid;
                    }
                    .o_voucher_custom .o_vc-signatures td {
                        width: 33.33%;
                        padding: 0;
                    }
                    .o_voucher_custom .o_vc-sign-title {
                        font-weight: 600;
                        font-size: 9.5pt;
                        background-color: #f0f0f0;
                        padding: 3px 8px;
                        border-bottom: 1px solid #ddd;
                    }
                    .o_voucher_custom .o_vc-sign-body {
                        padding: 4px 8px 5px;
                        font-size: 9.5pt;
                    }
                    .o_voucher_custom .o_vc-sign-line {
                        border-bottom: 1px solid #999;
                        min-height: 10px;
                        margin-top: 1px;
                    }
                    .o_voucher_custom .o_vc-sign-field {
                        margin-bottom: 2px;
                    }
                    .o_voucher_custom .o_vc-sign-field-label {
                        color: #666;
                    }
                </style>

                <h2 class="o_vc-main-title"><t t-esc="values['labels']['title']"/></h2>

                <!-- Meta: digital copy + document refs -->
                <table class="o_vc-meta o_ignore_layout_styling">
                    <tr>
                        <td class="o_vc-digital" rowspan="2">
                            <strong>DIGITAL COPY</strong>
                            <div class="o_vc-digital-sub">Accounting / Administration</div>
                        </td>
                        <td class="o_vc-label">Trans. Date</td>
                        <td><span t-field="o.date"/></td>
                        <td class="o_vc-label">Doc No</td>
                        <td><span t-esc="values['doc_number']"/></td>
                    </tr>
                    <tr>
                        <td class="o_vc-label">Cheque No</td>
                        <td><span t-esc="values['check_number'] or '—'"/></td>
                        <td class="o_vc-label">Source</td>
                        <td><span t-esc="values['source_label']"/></td>
                    </tr>
                </table>

                <!-- Payment / Receipt details (compact 4-column grid) -->
                <table class="o_vc-details o_ignore_layout_styling">
                    <tr>
                        <td class="o_vc-label"><t t-esc="values['labels']['partner_label']"/></td>
                        <td class="o_vc-value" colspan="3"><span t-field="o.partner_id"/></td>
                    </tr>
                    <tr>
                        <td class="o_vc-label"><t t-esc="values['labels']['description_label']"/></td>
                        <td class="o_vc-value" colspan="3"><span t-field="o.memo"/></td>
                    </tr>
                    <tr>
                        <td class="o_vc-label">Project</td>
                        <td class="o_vc-value o_vc-value-long" colspan="3"><span t-esc="values['project_names'] or '—'"/></td>
                    </tr>
                    <tr>
                        <td class="o_vc-label">Project Analytic Account</td>
                        <td class="o_vc-value o_vc-value-long" colspan="3"><span t-esc="values['project_accounts'] or '—'"/></td>
                    </tr>
                    <tr>
                        <td class="o_vc-label">Donor</td>
                        <td class="o_vc-value" colspan="3"><span t-esc="values['donors'] or '—'"/></td>
                    </tr>
                    <tr>
                        <td class="o_vc-label"><t t-esc="values['labels']['amount_label']"/></td>
                        <td class="o_vc-value">
                            <strong>
                                <span t-field="o.amount" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                            </strong>
                        </td>
                        <td class="o_vc-label">In Words</td>
                        <td class="o_vc-value"><span t-field="o.amount_in_words"/></td>
                    </tr>
                    <tr t-if="values.get('currency_rate_info')">
                        <td class="o_vc-label">Exchange Rate</td>
                        <td class="o_vc-value">
                            <span t-esc="values['currency_rate_info']['rate_display']"/>
                            (<span t-esc="values['currency_rate_info']['date_display']"/>)
                        </td>
                        <td class="o_vc-label">Payment Mode</td>
                        <td class="o_vc-value"><span t-field="o.journal_id"/></td>
                    </tr>
                    <tr t-if="not values.get('currency_rate_info')">
                        <td class="o_vc-label">Payment Mode</td>
                        <td class="o_vc-value" colspan="3"><span t-field="o.journal_id"/></td>
                    </tr>
                    <tr class="o_vc-note-row">
                        <td colspan="4"><t t-esc="values['labels']['note']"/></td>
                    </tr>
                </table>

                <!-- Journal lines -->
                <table class="o_vc-table o_ignore_layout_styling">
                    <colgroup>
                        <col class="o_vc-col-gl"/>
                        <col class="o_vc-col-dept"/>
                        <col class="o_vc-col-desc"/>
                        <col class="o_vc-amount"/>
                        <col class="o_vc-amount"/>
                    </colgroup>
                    <tbody>
                        <tr class="o_vc-table-head">
                            <td>GL Account</td>
                            <td>Dept</td>
                            <td>Description</td>
                            <td class="text-end o_vc-amount">Debit</td>
                            <td class="text-end o_vc-amount">Credit</td>
                        </tr>
                        <tr class="o_vc-section-title">
                            <td colspan="5">
                                <strong t-esc="values['branch_name']"/>
                                <t t-foreach="values['journal_sections']" t-as="section">
                                    — <span t-esc="section['title']"/>
                                </t>
                            </td>
                        </tr>
                        <t t-foreach="values['journal_sections']" t-as="section">
                            <t t-foreach="section['lines']" t-as="line">
                                <tr>
                                    <td t-esc="line['account_name']"/>
                                    <td t-esc="line['dept']"/>
                                    <td t-esc="line['description']"/>
                                    <td class="text-end o_vc-amount">
                                        <span t-if="line['debit']" t-out="line['debit']" t-options="{'widget': 'monetary', 'display_currency': o.company_currency_id}"/>
                                        <span t-else="">&#160;</span>
                                    </td>
                                    <td class="text-end o_vc-amount">
                                        <span t-if="line['credit']" t-out="line['credit']" t-options="{'widget': 'monetary', 'display_currency': o.company_currency_id}"/>
                                        <span t-else="">&#160;</span>
                                    </td>
                                </tr>
                            </t>
                        </t>
                        <tr t-if="not values['journal_sections']">
                            <td colspan="5" class="text-center text-muted">No journal items posted yet.</td>
                        </tr>
                        <tr class="o_vc-table-total">
                            <td colspan="3" class="text-end"><t t-esc="values['labels']['grand_total_label']"/></td>
                            <td class="text-end o_vc-amount">
                                <span t-out="values['total_debit']" t-options="{'widget': 'monetary', 'display_currency': o.company_currency_id}"/>
                            </td>
                            <td class="text-end o_vc-amount">
                                <span t-out="values['total_credit']" t-options="{'widget': 'monetary', 'display_currency': o.company_currency_id}"/>
                            </td>
                        </tr>
                    </tbody>
                </table>

                <!-- Signatures (compact) -->
                <table class="o_vc-signatures o_ignore_layout_styling">
                    <tr>
                        <td>
                            <div class="o_vc-sign-title">Checked By</div>
                            <div class="o_vc-sign-body">
                                <div class="o_vc-sign-field"><span class="o_vc-sign-field-label">Name:</span><div class="o_vc-sign-line"/></div>
                                <div class="o_vc-sign-field"><span class="o_vc-sign-field-label">Position:</span><div class="o_vc-sign-line"/></div>
                                <div class="o_vc-sign-field"><span class="o_vc-sign-field-label">Sign:</span><div class="o_vc-sign-line"/></div>
                            </div>
                        </td>
                        <td>
                            <div class="o_vc-sign-title">Reviewed By</div>
                            <div class="o_vc-sign-body">
                                <div class="o_vc-sign-field"><span class="o_vc-sign-field-label">Name:</span><div class="o_vc-sign-line"/></div>
                                <div class="o_vc-sign-field"><span class="o_vc-sign-field-label">Position:</span><div class="o_vc-sign-line"/></div>
                                <div class="o_vc-sign-field"><span class="o_vc-sign-field-label">Sign:</span><div class="o_vc-sign-line"/></div>
                            </div>
                        </td>
                        <td>
                            <div class="o_vc-sign-title">Accounts Officer</div>
                            <div class="o_vc-sign-body">
                                <div class="o_vc-sign-field"><span class="o_vc-sign-field-label">Name:</span><div class="o_vc-sign-line"/></div>
                                <div class="o_vc-sign-field"><span class="o_vc-sign-field-label">Position:</span><div class="o_vc-sign-line"/></div>
                                <div class="o_vc-sign-field"><span class="o_vc-sign-field-label">Sign:</span><div class="o_vc-sign-line"/></div>
                            </div>
                        </td>
                    </tr>
                </table>
            </div>
        </t>
    </template>

    <!-- Voucher layout: company footer + page numbers, no letterhead header -->
    <template id="external_layout_voucher">
        <t t-if="not o" t-set="o" t-value="doc"/>
        <t t-if="not company">
            <t t-if="company_id">
                <t t-set="company" t-value="company_id"/>
            </t>
            <t t-elif="o and 'company_id' in o and o.company_id.sudo()">
                <t t-set="company" t-value="o.company_id.sudo()"/>
            </t>
            <t t-else="">
                <t t-set="company" t-value="res_company"/>
            </t>
        </t>
        <t t-set="layout_background_url"
           t-value="'data:image/png;base64,%s' % company.layout_background_image.decode('utf-8') if company.layout_background_image and company.layout_background == 'Custom' else
                '/base/static/img/demo_logo_report.png' if company.layout_background == 'Demo logo' else ''"/>
        <div t-attf-class="article o_report_layout_standard o_table_standard o_company_#{company.id}_layout o_snail_mail {{'o_report_layout_background' if company.layout_background != 'Blank' else ''}}"
             t-attf-style="{{ 'background-image: url(%s);' % layout_background_url if layout_background_url else '' }}"
             t-att-data-oe-model="o and o._name"
             t-att-data-oe-id="o and o.id"
             t-att-data-oe-lang="o and o.env.context.get('lang')">
            <t t-out="0"/>
        </div>
        <div t-attf-class="footer o_company_#{company.id}_layout {{report_type != 'pdf' and 'mt-auto'}}">
            <div class="o_footer_content d-flex border-top pt-2">
                <div class="flex-grow-1 text-start me-2" t-field="company.report_footer"/>
                <div class="text-end text-muted">
                    <div t-if="report_type == 'pdf' and display_name_in_footer" t-out="o.name">(document name)</div>
                    <div t-if="report_type == 'pdf'" class="text-nowrap">Page <span class="page"/> / <span class="topage"/></div>
                </div>
            </div>
        </div>
    </template>

    <template id="report_payment_voucher">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="lang" t-value="o.partner_id.lang or o.company_id.partner_id.lang"/>
                <t t-set="voucher_type" t-value="'payment'"/>
                <t t-call="voucher_custom.report_payment_voucher_document" t-lang="lang"/>
            </t>
        </t>
    </template>

    <template id="report_receipt_voucher">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="lang" t-value="o.partner_id.lang or o.company_id.partner_id.lang"/>
                <t t-set="voucher_type" t-value="'receipt'"/>
                <t t-call="voucher_custom.report_payment_voucher_document" t-lang="lang"/>
            </t>
        </t>
    </template>

    <record id="action_report_payment_voucher" model="ir.actions.report">
        <field name="name">Payment Voucher</field>
        <field name="model">account.payment</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">voucher_custom.report_payment_voucher</field>
        <field name="report_file">voucher_custom.report_payment_voucher</field>
        <field name="print_report_name">'Payment Voucher - %s' % (object.name)</field>
        <field name="paperformat_id" ref="voucher_custom.paperformat_voucher_jesmar"/>
        <field name="binding_model_id" ref="account.model_account_payment"/>
        <field name="binding_type">report</field>
        <field name="domain">[('payment_type', '=', 'outbound')]</field>
    </record>

    <record id="action_report_receipt_voucher" model="ir.actions.report">
        <field name="name">Receipt Voucher</field>
        <field name="model">account.payment</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">voucher_custom.report_receipt_voucher</field>
        <field name="report_file">voucher_custom.report_receipt_voucher</field>
        <field name="print_report_name">'Receipt Voucher - %s' % (object.name)</field>
        <field name="paperformat_id" ref="voucher_custom.paperformat_voucher_jesmar"/>
        <field name="binding_model_id" ref="account.model_account_payment"/>
        <field name="binding_type">report</field>
        <field name="domain">[('payment_type', '=', 'inbound')]</field>
    </record>
</odoo>
