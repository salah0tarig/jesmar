<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Dedicated paper format for Payment / Receipt / Journal vouchers.
         Margins sized for web.external_layout (logo + company address header). -->
    <record id="paperformat_voucher_jesmar" model="report.paperformat">
        <field name="name">Jesmar Voucher (A4)</field>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">45</field>
        <field name="margin_bottom">14</field>
        <field name="margin_left">10</field>
        <field name="margin_right">10</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">34</field>
        <field name="disable_shrinking" eval="True"/>
        <field name="dpi">96</field>
    </record>
</odoo>
