<odoo>
    <record id="rule_procurement_company" model="ir.rule">
        <field name="name">Procurement Company Rule</field>
        <field name="model_id" ref="model_procurement_requisition"/>
        <field name="domain_force">[('company_id','in',company_ids)]</field>
    </record>
    <record id="module_category_procurement" model="ir.module.category">
        <field name="name">Procurement</field>
        <field name="description">Procurement Access Rights</field>
        <field name="sequence">20</field>
    </record>
    <record id="privilege_procurement" model="res.groups.privilege">
        <field name="name">Procurement</field>
        <field name="category_id" ref="module_category_procurement"/>
        <field name="sequence">10</field>
    </record>
    <record id="group_pr_user" model="res.groups">
        <field name="name">PR User</field>
        <field name="privilege_id" ref="privilege_procurement"/>
    </record>

    <record id="group_finance_approval" model="res.groups">
        <field name="name">Finance Approval</field>
        <field name="privilege_id" ref="privilege_procurement"/>
        <field name="implied_ids" eval="[(4, ref('group_pr_user'))]"/>
    </record>

    <record id="group_procurement_officer" model="res.groups">
        <field name="name">Procurement Officer</field>
        <field name="privilege_id" ref="privilege_procurement"/>
        <field name="implied_ids" eval="[(4, ref('group_finance_approval'))]"/>
    </record>

    <record id="group_po_manager" model="res.groups">
        <field name="name">PO Manager</field>
        <field name="privilege_id" ref="privilege_procurement"/>
        <field name="implied_ids" eval="[(4, ref('group_procurement_officer'))]"/>
    </record>

    <record id="group_store_user" model="res.groups">
        <field name="name">Store / Requesting Dept</field>
        <field name="privilege_id" ref="privilege_procurement"/>
        <field name="implied_ids" eval="[(4, ref('group_po_manager'))]"/>
    </record>

    <record id="group_finance_payment" model="res.groups">
        <field name="name">Finance Payment</field>
        <field name="privilege_id" ref="privilege_procurement"/>
        <field name="implied_ids" eval="[(4, ref('group_store_user'))]"/>
    </record>

    <!-- PR users must read Programs linked on requisitions even when they are not
         project followers (standard "followers only" rule). Multi-company display
         of project_id is handled via bypass_search_access on the field. -->
    <record id="project_pr_user_read_rule" model="ir.rule">
        <field name="name">Project: procurement users can read programs</field>
        <field name="model_id" ref="project.model_project_project"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('purchase_request.group_pr_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="project_task_pr_user_read_rule" model="ir.rule">
        <field name="name">Project Task: procurement users can read activities</field>
        <field name="model_id" ref="project.model_project_task"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('purchase_request.group_pr_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

</odoo>
